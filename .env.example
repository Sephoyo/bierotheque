# Variables d'environnement attendues par docker-compose.yml en production.
#
# Sur Dokploy : ne pas déployer ce fichier tel quel — renseigner ces mêmes
# clés dans l'onglet "Environment" du projet Compose sur le dashboard Dokploy
# (valeurs stockées côté Dokploy, jamais commitées). Ce fichier ne sert que de
# référence/checklist, et pour un déploiement local hors Dokploy (docker
# compose --env-file .env up -d --build, après avoir copié ce fichier en
# .env et rempli les valeurs).

# --- PostgreSQL ---
POSTGRES_DB=bierotheque
POSTGRES_USER=app
# Mot de passe fort dédié à cet environnement (ne pas réutiliser celui de dev)
POSTGRES_PASSWORD=

# --- Backend Symfony ---
# 32 caractères hexadécimaux aléatoires, ex : openssl rand -hex 16
APP_SECRET=
# Regex ancrée sur le domaine réel du frontend en prod, ex : ^https://bierotheque\.fr$
CORS_ALLOW_ORIGIN=
# Utilisé par Symfony pour générer des URLs absolues en contexte CLI (import, etc.)
DEFAULT_URI=https://api.bierotheque.fr

# --- Import Overpass (valeurs par défaut déjà correctes, à ne changer que si besoin) ---
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OVERPASS_BBOX=41.2,-5.3,51.15,9.7

# --- Espace admin (/admin) ---
ADMIN_USERNAME=admin
# Générer avec : docker compose run --rm php php bin/console security:hash-password
ADMIN_PASSWORD_HASH=

# --- Frontend Angular ---
# URL publique de l'API, telle qu'atteignable depuis le navigateur du visiteur
# (donc le domaine configuré côté Dokploy pour le service "php", pas le nom
# de service interne au réseau Docker)
API_BASE_URL=https://api.bierotheque.fr/api
